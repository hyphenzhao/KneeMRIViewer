# Normalise to LF in the repository.
#
# This is not cosmetic. A shell script checked out with CRLF fails on Linux
# with an unhelpful error - `set -euo pipefail\r` makes bash refuse to start -
# and that has already cost this project a debugging session. The deployment
# scripts run on Ubuntu regardless of which platform edits them.
* text=auto eol=lf

*.sh    text eol=lf
*.py    text eol=lf
*.mjs   text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.sql   text eol=lf
*.yaml  text eol=lf
*.toml  text eol=lf
*.service text eol=lf

*.pyz   binary
*.png   binary
